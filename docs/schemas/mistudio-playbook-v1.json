{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hitsainet/miAssist/main/docs/schemas/mistudio-playbook-v1.json",
  "title": "miStudio playbook, v1",
  "description": "A miAssist playbook definition and the status shape its provider returns. Text fields are keys into the playbook's guidance file. Owned by miAssist. Generated by scripts/write_contracts.py; do not edit.",
  "x-contract": "mistudio.playbook/v1",
  "$ref": "#/$defs/playbook",
  "$defs": {
    "playbook": {
      "additionalProperties": false,
      "description": "A playbook definition. Offered when at least one of `requires_apps` is installed and at least one `entry` step can run. Step ids are unique (checked by Core's registry).",
      "properties": {
        "kind": {
          "const": "mistudio.playbook/v1",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{2,47}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "$ref": "#/$defs/text_key"
        },
        "goal": {
          "$ref": "#/$defs/text_key"
        },
        "requires_apps": {
          "items": {
            "$ref": "#/$defs/app_id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "steps": {
          "contains": {
            "properties": {
              "entry": {
                "const": true
              }
            },
            "required": [
              "entry"
            ]
          },
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "title",
        "goal",
        "requires_apps",
        "steps"
      ],
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "description": "One step of a playbook: the miAssist tool it calls and when it is done.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/tool_name",
          "description": "A miAssist tool (miassist_...)."
        },
        "explain_beginner": {
          "$ref": "#/$defs/text_key"
        },
        "explain_expert": {
          "$ref": "#/$defs/text_key"
        },
        "done_when": {
          "$ref": "#/$defs/done_when"
        },
        "title": {
          "$ref": "#/$defs/text_key"
        },
        "entry": {
          "default": false,
          "description": "The journey may start here.",
          "type": "boolean"
        },
        "args": {
          "additionalProperties": true,
          "description": "Literal arguments the status provider proposes in next.",
          "type": "object"
        },
        "waits_for": {
          "items": {
            "description": "What a step can wait for. `operator_action` is a hand-off the operator does in the app, such as arming or activating.",
            "enum": [
              "approval",
              "gpu",
              "job",
              "operator_action"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requires_apps": {
          "description": "Any of: the step is skipped, and listed in not_in_this_installation, when none is installed. Absent means the playbook's own list.",
          "items": {
            "$ref": "#/$defs/app_id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "tool",
        "explain_beginner",
        "explain_expert",
        "done_when"
      ],
      "type": "object"
    },
    "text_key": {
      "description": "A key into the playbook's guidance file. The resolved text has bounds: title 1-80, goal 1-300, explain_beginner 1-1200, explain_expert 1-300, done_when.description 1-300.",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,119}$",
      "type": "string"
    },
    "done_when": {
      "additionalProperties": false,
      "description": "When a step is done: a JSON Pointer (RFC 6901) into the step tool's `data` and an operator. `value` is required when `op` is `equals`, `in` or `gte`, and absent otherwise.",
      "else": {
        "not": {
          "required": [
            "value"
          ]
        }
      },
      "if": {
        "properties": {
          "op": {
            "enum": [
              "equals",
              "in",
              "gte"
            ]
          }
        },
        "required": [
          "op"
        ]
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/text_key"
        },
        "pointer": {
          "description": "An RFC 6901 JSON Pointer into the step tool's data.",
          "type": "string"
        },
        "op": {
          "enum": [
            "exists",
            "truthy",
            "equals",
            "in",
            "gte"
          ],
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "description",
        "pointer",
        "op"
      ],
      "then": {
        "required": [
          "value"
        ]
      },
      "type": "object"
    },
    "playbook_status": {
      "additionalProperties": false,
      "description": "Where a person is in a playbook. `next` is one suggested step (or null), not a list.",
      "properties": {
        "playbook_id": {
          "type": "string"
        },
        "playbook_version": {
          "minimum": 1,
          "type": "integer"
        },
        "finished": {
          "type": "boolean"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "done": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "mistudio-result-language-v1.json#/$defs/next_step"
            },
            {
              "type": "null"
            }
          ]
        },
        "waiting": {
          "items": {
            "$ref": "#/$defs/waiting"
          },
          "type": "array"
        },
        "expected": {
          "description": "Plain words: what to expect.",
          "type": "string"
        },
        "not_in_this_installation": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "playbook_id",
        "playbook_version",
        "finished",
        "where",
        "done",
        "next",
        "waiting",
        "expected",
        "not_in_this_installation"
      ],
      "type": "object"
    },
    "waiting": {
      "additionalProperties": false,
      "description": "Something a playbook is waiting for. For `operator_action`, `detail` says what to do and where.",
      "properties": {
        "kind": {
          "description": "What a step can wait for. `operator_action` is a hand-off the operator does in the app, such as arming or activating.",
          "enum": [
            "approval",
            "gpu",
            "job",
            "operator_action"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "approval": {
          "$ref": "mistudio-result-language-v1.json#/$defs/approval"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "type": "object"
    },
    "app_id": {
      "description": "One of the suite's four apps.",
      "enum": [
        "miworkbench",
        "miserver",
        "midataworks",
        "miforge"
      ],
      "type": "string"
    },
    "tool_name": {
      "description": "An MCP tool's name.",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "type": "string"
    }
  }
}
