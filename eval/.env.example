# miassist_eval environment (FTID §9). None of these is a secret; the client key is read from the
# operator's OWN environment by name, by hand only, never from a file the harness writes (M13).
# MIASSIST_REQUIRE_CASSETTES=1            # cassette tests fail instead of skipping (private CI from 002-P2)
# MIASSIST_EVAL_CLIENT_KEY_ENV=ANTHROPIC_API_KEY
# MIASSIST_EVAL_BUDGET_USD=               # a tier-1b suite without a budget refuses to start
# MIASSIST_EVAL_LIVE_APPS=                # record, tier 2, verify-cassettes --live-apps (workstation only)
# MIASSIST_EVAL_REF_OPENAPI_DIR=eval/reference/openapi
# MIASSIST_ROUTE_SNAPSHOT_DIR=tests/fixtures/openapi
# MIASSIST_REQUIRE_CROSS_REPO_CHECKS=1
# MIASSIST_EVAL_REF_MAX_AGE_DAYS=30       # may only be lowered
# MIASSIST_EVAL_REF_AGE_MODE=warn         # fail only in eval-prerelease.yml (A31)
# MIASSIST_WB_PAYLOAD_VECTORS=docs/schemas/miworkbench-approval-payload-vectors-v1.json
# MIASSIST_CORE_CASSETTE_SCHEMA=tests/fixtures/miassist-cassette-v1.schema.json
# MIASSIST_REQUIRE_CORE=1                 # Core's pieces must exist (set once Core re-vendors 045 21.6 / 044)
