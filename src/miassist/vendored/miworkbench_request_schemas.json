{
 "commit": "06ab2ee30",
 "routes": {
  "POST /api/v1/probe-monitors/probes/{probe_id}/definition": {
   "body": {
    "additionalProperties": false,
    "description": "What a build takes. `acknowledge_below_rung2` is the FR-5 gate's key.",
    "properties": {
     "acknowledge_below_rung2": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Acknowledge Below Rung2"
     },
     "seed": {
      "default": 1337,
      "title": "Seed",
      "type": "integer"
     },
     "vector_count": {
      "default": 16,
      "maximum": 32.0,
      "minimum": 8.0,
      "title": "Vector Count",
      "type": "integer"
     }
    },
    "title": "BuildDefinitionRequest",
    "type": "object"
   },
   "body_required": true,
   "query": [],
   "query_schemas": {}
  },
  "POST /api/v1/probe-monitors/probes/{probe_id}/evaluate": {
   "body": {
    "items": {
     "type": "string"
    },
    "title": "Dataset Ids",
    "type": "array"
   },
   "body_required": true,
   "query": [
    "sample_rows"
   ],
   "query_schemas": {
    "sample_rows": {
     "anyOf": [
      {
       "maximum": 200000,
       "minimum": 100,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "description": "Score a seeded sample of this many rows of each view; the seed is the view and the size, so every probe evaluated at this size scores the same rows. Required for a calibration view.",
     "title": "Sample Rows"
    }
   }
  },
  "POST /api/v1/probe-monitors/runs": {
   "body": {
    "additionalProperties": false,
    "properties": {
     "behaviour": {
      "anyOf": [
       {
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Behaviour"
     },
     "behaviour_label": {
      "anyOf": [
       {
        "maxLength": 255,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Behaviour Label"
     },
     "calibration_dataset_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Calibration Dataset Id"
     },
     "config": {
      "additionalProperties": false,
      "description": "What a run was asked to do. Echoed verbatim onto the row (FR-15).",
      "properties": {
       "acknowledge_rule_choice": {
        "anyOf": [
         {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Acknowledge Rule Choice"
       },
       "batch_size": {
        "anyOf": [
         {
          "minimum": 1.0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "title": "Batch Size"
       },
       "calibration_max_rows": {
        "default": 5000,
        "maximum": 200000.0,
        "minimum": 100.0,
        "title": "Calibration Max Rows",
        "type": "integer"
       },
       "dtype": {
        "anyOf": [
         {
          "enum": [
           "float16",
           "bfloat16",
           "float32"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Dtype"
       },
       "eval_max_rows": {
        "anyOf": [
         {
          "maximum": 200000.0,
          "minimum": 100.0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "title": "Eval Max Rows"
       },
       "layers": {
        "anyOf": [
         {
          "items": {
           "type": "integer"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "title": "Layers"
       },
       "max_length": {
        "default": 4096,
        "maximum": 131072.0,
        "minimum": 16.0,
        "title": "Max Length",
        "type": "integer"
       },
       "rolling_windows": {
        "items": {
         "type": "integer"
        },
        "title": "Rolling Windows",
        "type": "array"
       },
       "rules": {
        "items": {
         "type": "string"
        },
        "title": "Rules",
        "type": "array"
       },
       "sae_k": {
        "items": {
         "type": "integer"
        },
        "title": "Sae K",
        "type": "array"
       },
       "sae_variant": {
        "default": false,
        "title": "Sae Variant",
        "type": "boolean"
       },
       "scope": {
        "default": "all",
        "enum": [
         "all",
         "assistant",
         "user",
         "last_assistant",
         "content"
        ],
        "title": "Scope",
        "type": "string"
       },
       "seed": {
        "default": 1337,
        "title": "Seed",
        "type": "integer"
       },
       "selection_rule": {
        "default": "recall_at_decision",
        "enum": [
         "auroc",
         "recall_at_decision"
        ],
        "title": "Selection Rule",
        "type": "string"
       },
       "skip_template_prefix": {
        "default": true,
        "title": "Skip Template Prefix",
        "type": "boolean"
       },
       "stride": {
        "anyOf": [
         {
          "minimum": 1.0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "default": 5,
        "title": "Stride"
       },
       "target_fpr": {
        "default": 0.01,
        "exclusiveMaximum": 1.0,
        "exclusiveMinimum": 0.0,
        "title": "Target Fpr",
        "type": "number"
       },
       "top_n_layers": {
        "default": 1,
        "maximum": 8.0,
        "minimum": 1.0,
        "title": "Top N Layers",
        "type": "integer"
       },
       "val_fraction": {
        "default": 0.15,
        "exclusiveMaximum": 0.5,
        "exclusiveMinimum": 0.0,
        "title": "Val Fraction",
        "type": "number"
       }
      },
      "title": "ProbeRunConfig",
      "type": "object"
     },
     "eval_dataset_ids": {
      "items": {
       "type": "string"
      },
      "title": "Eval Dataset Ids",
      "type": "array"
     },
     "gpu": {
      "default": "auto",
      "title": "Gpu",
      "type": "string"
     },
     "model_id": {
      "title": "Model Id",
      "type": "string"
     },
     "train_dataset_id": {
      "title": "Train Dataset Id",
      "type": "string"
     }
    },
    "required": [
     "model_id",
     "train_dataset_id"
    ],
    "title": "ProbeRunCreate",
    "type": "object"
   },
   "body_required": true,
   "query": [],
   "query_schemas": {}
  },
  "POST /api/v1/steering/async/combined": {
   "body": {
    "description": "Schema for combined multi-feature steering request.\n\nApplies ALL selected features simultaneously in a single generation pass,\nrather than generating separate outputs for each feature.\n\nUse cases:\n- Test synergistic effects (e.g., \"formal\" + \"positive\" = professional tone)\n- Create complex behavioral changes with multiple influences\n- Explore feature interactions and emergent behaviors",
    "properties": {
     "advanced_params": {
      "description": "Advanced generation parameters",
      "properties": {
       "do_sample": {
        "default": true,
        "description": "Whether to use sampling (vs greedy)",
        "title": "Do Sample",
        "type": "boolean"
       },
       "frequency_penalty": {
        "default": 0.0,
        "description": "Frequency penalty",
        "maximum": 2.0,
        "minimum": -2.0,
        "title": "Frequency Penalty",
        "type": "number"
       },
       "presence_penalty": {
        "default": 0.0,
        "description": "Presence penalty",
        "maximum": 2.0,
        "minimum": -2.0,
        "title": "Presence Penalty",
        "type": "number"
       },
       "repetition_penalty": {
        "default": 1.15,
        "description": "Repetition penalty (1.0=none, 1.1-1.2=mild, 1.3+=strong)",
        "maximum": 2.0,
        "minimum": 0.5,
        "title": "Repetition Penalty",
        "type": "number"
       },
       "stop_sequences": {
        "description": "Stop sequences",
        "items": {
         "type": "string"
        },
        "title": "Stop Sequences",
        "type": "array"
       }
      },
      "title": "AdvancedGenerationParams",
      "type": "object"
     },
     "compute_metrics": {
      "default": true,
      "description": "Compute evaluation metrics",
      "title": "Compute Metrics",
      "type": "boolean"
     },
     "generation_params": {
      "description": "Generation parameters",
      "properties": {
       "max_new_tokens": {
        "default": 100,
        "description": "Maximum tokens to generate",
        "maximum": 2048.0,
        "minimum": 1.0,
        "title": "Max New Tokens",
        "type": "integer"
       },
       "num_samples": {
        "default": 1,
        "description": "Number of samples per configuration",
        "maximum": 10.0,
        "minimum": 1.0,
        "title": "Num Samples",
        "type": "integer"
       },
       "seed": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Random seed for reproducibility",
        "title": "Seed"
       },
       "temperature": {
        "default": 0.7,
        "description": "Sampling temperature",
        "maximum": 2.0,
        "minimum": 0.0,
        "title": "Temperature",
        "type": "number"
       },
       "top_k": {
        "default": 50,
        "description": "Top-k sampling (0 to disable)",
        "maximum": 500.0,
        "minimum": 0.0,
        "title": "Top K",
        "type": "integer"
       },
       "top_p": {
        "default": 0.9,
        "description": "Nucleus sampling probability",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Top P",
        "type": "number"
       }
      },
      "title": "GenerationParams",
      "type": "object"
     },
     "gpu": {
      "default": "auto",
      "description": "\"auto\" to run on the GPU with the most free memory when the job starts (a model no single GPU can hold is split across GPUs where the job supports it), \"all\" to split the model across every GPU, or a GPU UUID (or index) from /api/v1/system/gpu-list to run on that card. A named card, or a split, that cannot take the job is refused, never swapped for another choice.",
      "maxLength": 64,
      "pattern": "^(auto|all|[0-9]{1,2}|([Gg][Pp][Uu]-)?[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$",
      "title": "Gpu",
      "type": "string"
     },
     "include_baseline": {
      "default": true,
      "description": "Include unsteered baseline output for comparison",
      "title": "Include Baseline",
      "type": "boolean"
     },
     "model_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Model ID (defaults to SAE's linked model)",
      "title": "Model Id"
     },
     "prompt": {
      "description": "Input prompt for generation",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
     },
     "sae_id": {
      "description": "SAE ID to use for steering",
      "title": "Sae Id",
      "type": "string"
     },
     "selected_features": {
      "description": "List of features to apply together (1-20)",
      "items": {
       "description": "Schema for a feature selected for steering.",
       "properties": {
        "additional_strengths": {
         "anyOf": [
          {
           "items": {
            "type": "number"
           },
           "type": "array"
          },
          {
           "type": "null"
          }
         ],
         "description": "Up to 3 additional strengths to test simultaneously",
         "title": "Additional Strengths"
        },
        "color": {
         "default": "teal",
         "description": "Color for UI display (cosmetic; one of the 20-name palette)",
         "enum": [
          "teal",
          "blue",
          "purple",
          "amber",
          "rose",
          "cyan",
          "lime",
          "orange",
          "fuchsia",
          "sky",
          "emerald",
          "violet",
          "pink",
          "indigo",
          "yellow",
          "red",
          "green",
          "sapphire",
          "magenta",
          "gold"
         ],
         "title": "Color",
         "type": "string"
        },
        "comparison_id": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Links to the comparison job this instance was used in",
         "title": "Comparison Id"
        },
        "feature_idx": {
         "description": "Feature index in the SAE",
         "minimum": 0.0,
         "title": "Feature Idx",
         "type": "integer"
        },
        "instance_id": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Unique identifier for this selection instance (allows duplicates of same feature)",
         "title": "Instance Id"
        },
        "label": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Feature label for display",
         "title": "Label"
        },
        "layer": {
         "description": "Target layer for steering (L0, L1, etc.)",
         "minimum": 0.0,
         "title": "Layer",
         "type": "integer"
        },
        "sae_id": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "SAE for THIS feature (015); defaults to the request sae_id",
         "title": "Sae Id"
        },
        "strength": {
         "description": "Raw steering coefficient (Neuronpedia-compatible). Values like 0.07 for subtle effects, 80 for strong effects, 200+ for extreme. Negative values suppress the feature.",
         "maximum": 300.0,
         "minimum": -300.0,
         "title": "Strength",
         "type": "number"
        }
       },
       "required": [
        "feature_idx",
        "layer",
        "strength"
       ],
       "title": "SelectedFeature",
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Selected Features",
      "type": "array"
     }
    },
    "required": [
     "sae_id",
     "prompt",
     "selected_features"
    ],
    "title": "CombinedSteeringRequest",
    "type": "object"
   },
   "body_required": true,
   "query": [],
   "query_schemas": {}
  },
