      "maxLength": 64,
      "pattern": "^(auto|all|[0-9]{1,2}|([Gg][Pp][Uu]-)?[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$",
      "title": "Gpu",
      "type": "string"
     },
     "layer": {
      "description": "Target layer",
      "minimum": 0.0,
      "title": "Layer",
      "type": "integer"
     },
     "model_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Model ID",
      "title": "Model Id"
     },
     "prompt": {
      "description": "Input prompt",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
     },
     "sae_id": {
      "description": "SAE ID to use for steering",
      "title": "Sae Id",
      "type": "string"
     },
     "strength_values": {
      "description": "List of strength values to test (e.g., [0, 25, 50, 100, 200])",
      "items": {
       "type": "number"
      },
      "maxItems": 10,
