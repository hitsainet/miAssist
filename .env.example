# miAssist's environment (PADR ADR-015; Foundation task 2.6). Copy to .env; never commit .env.
# Blank means unset; an app whose URL is unset cannot be listed in MIASSIST_APPS.

# The installed set: a comma list of miworkbench, miserver, midataworks, miforge (empty: none).
MIASSIST_APPS=
# Each listed app's base URL (no credentials: a URL carrying user:pass@ refuses start).
MIASSIST_MIWORKBENCH_URL=
MIASSIST_MISERVER_URL=
MIASSIST_MIDATAWORKS_URL=
MIASSIST_MIFORGE_URL=
# Hostnames the MCP transport accepts in the Host header (comma list; any port).
MIASSIST_ALLOWED_HOSTS=localhost,127.0.0.1
# The base URL used in /p/new links (default: the request's own scheme and host).
MIASSIST_PUBLIC_BASE_URL=
# Listen address and port.
MIASSIST_HOST=0.0.0.0
MIASSIST_PORT=8765
# How often (seconds) each listed app's /api/health is probed, and its timeout.
MIASSIST_HEALTH_INTERVAL_S=60
MIASSIST_HEALTH_TIMEOUT_S=3
# Days a key's remembered settings are kept after last use.
MIASSIST_RETENTION_DAYS=180
# The request-body cap in bytes.
MIASSIST_MAX_REQUEST_BODY_BYTES=1048576
# Pending approvals miAssist may have waiting per app before it files no more (shared by all).
MIASSIST_MAX_PENDING_APPROVALS=10
# Overrides of the write floor's rate limits, JSON {entry: {count, window_s}} (never removes one).
MIASSIST_FLOOR_LIMITS=
# Above this size (bytes), or of unknown size, a Hugging Face import is handed to the operator.
MIASSIST_LARGE_IMPORT_BYTES=50000000000
# 003: a public dataset owner/name[:config[:split]] the detector playbook proposes as everyday
# text when the person names none; empty: the person is asked.
MIASSIST_EVERYDAY_TEXT_REPO=
# The settings store (Postgres 15). The password is the one secret; generate it, e.g. openssl rand -hex 24.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=miassist
POSTGRES_USER=miassist
POSTGRES_PASSWORD=
# Or one explicit async URL instead of the parts (no credentials in it; the password comes from
# POSTGRES_PASSWORD only when the URL is built from the parts).
MIASSIST_DATABASE_URL=
# Run the migrations and exit (the init container sets 1).
MIASSIST_MIGRATE=
